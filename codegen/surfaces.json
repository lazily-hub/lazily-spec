{
  "description": "Wire surfaces whose binding types are generated from the shared wire model (#lzwiremodel). Each surface names its source schema and the generated file each participating binding commits. Kernel semantics (Source/Computed/Effect, scheduling, scopes) are never generated.",
  "surfaces": [
    {
      "name": "receipts",
      "schema": "schemas/receipts.json",
      "targets": {
        "rust": {
          "repo": "lazily-rs",
          "path": "src/generated/receipts.rs"
        },
        "go": {
          "repo": "lazily-go",
          "path": "receipts_wire_gen.go",
          "package": "lazily"
        },
        "python": {
          "repo": "lazily-py",
          "path": "src/lazily/_receipts_wire_gen.py",
          "semantics_module": "._receipt_semantics",
          "mixins": {
            "ReceiptOutcome": "ReceiptOutcomeSemantics",
            "CausalReceipts": "CausalReceiptsSemantics"
          }
        },
        "kotlin": {
          "repo": "lazily-kt",
          "path": "src/main/kotlin/io/github/lazily/ReceiptsWireGen.kt",
          "package": "io.github.lazily",
          "variant_fields": {
            "CausalReceipts": "batch"
          }
        }
      }
    },
    {
      "name": "delta",
      "schema": "schemas/delta.json",
      "targets": {
        "python": {
          "repo": "lazily-py",
          "path": "src/lazily/_delta_wire_gen.py",
          "semantics_module": "._delta_semantics",
          "mixins": {
            "DeltaOp": "DeltaOpSemantics",
            "IpcValue": "IpcValueSemantics",
            "Delta": "DeltaSemantics"
          },
          "external": {
            "NodeKey": "._wire_scalars",
            "ShmBlobRef": "._wire_scalars"
          },
          "variant_fields": {
            "IpcValue.Inline": "data",
            "IpcValue.SharedBlob": "blob",
            "NodeState.Payload": "data",
            "NodeState.SharedBlob": "blob"
          },
          "envelope": false
        },
        "go": {
          "repo": "lazily-go",
          "path": "delta_wire_gen.go",
          "package": "lazily",
          "external": {
            "NodeKey": "",
            "ShmBlobRef": ""
          },
          "int64": {
            "NodeId": "NodeId",
            "Delta.base_epoch": "Epoch",
            "Delta.epoch": "Epoch"
          },
          "variant_fields": {
            "IpcValue.Inline": "Bytes",
            "IpcValue.SharedBlob": "Blob",
            "NodeState.Payload": "Bytes",
            "NodeState.SharedBlob": "Blob"
          },
          "interface_methods": {
            "DeltaOp": [
              {
                "sig": "TargetReadable(permissions *PeerPermissions, peer PeerId) bool",
                "doc": "TargetReadable reports whether peer may read every node this op names. Ops targeting an unreadable node are omitted from a permission-filtered delta."
              }
            ]
          },
          "envelope": false
        }
      }
    }
  ]
}
