{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazily.dev/schemas/sqlite-stores.json",
  "title": "Lazily SQLite store contract registry (#lazilysqlitestoreopen)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "drivers", "bindings"],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "busy_timeout_ms", "write_lock_acquisition", "forbidden", "doc"],
      "properties": {
        "id": {"const": "lazilysqlitestoreopen"},
        "busy_timeout_ms": {"type": "integer", "minimum": 1},
        "write_lock_acquisition": {"const": "autocommit_or_begin_immediate"},
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["deferred_read_then_write_transaction"]}
        },
        "doc": {"type": "string", "minLength": 1}
      }
    },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pattern"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "pattern": {"type": "string", "minLength": 1}
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["binding", "repo", "scan_roots", "sqlite"],
        "properties": {
          "binding": {"type": "string", "pattern": "^[a-z]+$"},
          "repo": {"type": "string", "pattern": "^lazily-[a-z]+$"},
          "scan_roots": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/relpath"}
          },
          "sqlite": {
            "oneOf": [
              {"const": "none"},
              {"$ref": "#/$defs/owned"},
              {"$ref": "#/$defs/host"}
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "relpath": {"type": "string", "minLength": 1, "pattern": "^(?:\\.|[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*)$"},
    "names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "owned": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection", "store", "driver_files", "busy_timeout", "two_writer_tests", "deferred_transaction_guard"],
      "properties": {
        "connection": {"const": "owned"},
        "store": {"type": "string", "minLength": 1},
        "driver_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relpath"}},
        "busy_timeout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ms", "file", "declaration", "test"],
          "properties": {
            "ms": {"type": "integer", "minimum": 1},
            "file": {"$ref": "#/$defs/relpath"},
            "declaration": {"type": "string", "minLength": 1},
            "test": {"type": "string", "minLength": 1}
          }
        },
        "two_writer_tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "names"],
          "properties": {
            "file": {"$ref": "#/$defs/relpath"},
            "names": {"$ref": "#/$defs/names"}
          }
        },
        "deferred_transaction_guard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "tokens"],
          "properties": {
            "file": {"$ref": "#/$defs/relpath"},
            "tokens": {"$ref": "#/$defs/names"}
          }
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection", "store", "obligation"],
      "properties": {
        "connection": {"const": "host"},
        "store": {"type": "string", "minLength": 1},
        "obligation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "marker"],
          "properties": {
            "file": {"$ref": "#/$defs/relpath"},
            "marker": {"const": "#lazilysqlitestoreopen"}
          }
        }
      }
    }
  }
}
