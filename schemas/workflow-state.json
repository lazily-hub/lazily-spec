{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazily.dev/schemas/workflow-state.json",
  "title": "Example workflow node type tags",
  "description": "Vocabulary for the sample workflow snapshot and delta. Applications define their own node type tags.",
  "schema_version": "2.0.0",
  "$ref": "#/$defs/TypeTag",
  "$defs": {
    "TypeTag": {
      "enum": [
        "workflow.document.baseline",
        "workflow.execution.cycle",
        "workflow.queue.head",
        "workflow.transport.patch"
      ]
    }
  }
}
