{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazily.dev/schemas/core-artifact-consumers.schema.json",
  "title": "Lazily Core artifact-consumer contract",
  "type": "object",
  "required": ["schema_version", "profile", "policy", "required_scenarios", "bindings"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "policy": {
      "type": "object",
      "required": ["pre_1_0_compatibility", "deprecation", "preview_disclaimer"],
      "additionalProperties": false,
      "properties": {
        "pre_1_0_compatibility": { "type": "string", "minLength": 1 },
        "deprecation": {
          "type": "object",
          "required": ["minimum_compatible_cohorts", "minimum_days"],
          "additionalProperties": false,
          "properties": {
            "minimum_compatible_cohorts": { "type": "integer", "minimum": 2 },
            "minimum_days": { "type": "integer", "minimum": 90 }
          }
        },
        "preview_disclaimer": { "type": "string", "minLength": 1 }
      }
    },
    "required_scenarios": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "source-computed-effect",
              "batch-coalescing",
              "scoped-disposal",
              "typed-context"
            ]
          },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "repository", "package", "consumer"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "repository": { "type": "string", "pattern": "^lazily-[a-z0-9-]+$" },
          "package": {
            "type": "object",
            "required": ["ecosystem", "coordinate"],
            "additionalProperties": false,
            "properties": {
              "ecosystem": {
                "type": "string",
                "enum": ["cargo", "npm", "pypi", "go", "maven", "cmake", "nuget", "pub", "zig"]
              },
              "coordinate": { "type": "string", "minLength": 1 }
            }
          },
          "consumer": {
            "type": "object",
            "required": ["target", "isolation", "dependency_source", "toolchain_points", "scenarios"],
            "additionalProperties": false,
            "properties": {
              "target": { "const": "core-artifact-consumer-check" },
              "isolation": { "const": "clean-temporary-project" },
              "dependency_source": { "const": "built-artifact-only" },
              "toolchain_points": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "items": { "enum": ["minimum", "current"] }
              },
              "scenarios": {
                "type": "array",
                "minItems": 4,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "source-computed-effect",
                    "batch-coalescing",
                    "scoped-disposal",
                    "typed-context"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
