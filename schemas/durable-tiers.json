{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazily.dev/schemas/durable-tiers.json",
  "title": "Lazily durable capability tiers",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tiers"],
  "properties": {
    "schema_version": {"const": 1},
    "tiers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rank",
          "requires",
          "transition_authority",
          "required_capabilities"
        ],
        "properties": {
          "id": {
            "enum": ["core", "client", "durable_host", "distributed_host", "accelerated_host"]
          },
          "rank": {"type": "integer", "minimum": 0, "maximum": 4},
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["core", "client", "durable_host", "distributed_host", "accelerated_host"]
            }
          },
          "transition_authority": {"enum": ["none", "durable_owner"]},
          "required_capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
          }
        }
      }
    }
  }
}
