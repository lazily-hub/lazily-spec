{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazily.dev/schemas/protobuf-graph-boundary-fixture.json",
  "title": "Protobuf graph-boundary logical trace fixture",
  "type": "object",
  "required": ["protocol_version", "schema_version", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "const": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "scenarios": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "description", "steps", "expect"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": { "type": "string", "minLength": 1 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_generation", "causal_epoch", "sequence", "kind"],
              "additionalProperties": true,
              "properties": {
                "source_generation": { "type": "integer", "minimum": 0 },
                "causal_epoch": { "type": "integer", "minimum": 0 },
                "sequence": { "type": "integer", "minimum": 0 },
                "kind": {
                  "enum": [
                    "cell_text_splice",
                    "bootstrap_snapshot",
                    "derived_projection",
                    "surface_observation"
                  ]
                }
              }
            }
          },
          "expect": {
            "type": "object",
            "required": ["cells", "decisions", "ordinary_snapshot_count", "logical_projection"],
            "additionalProperties": false,
            "properties": {
              "cells": { "type": "object", "additionalProperties": { "type": "string" } },
              "decisions": {
                "type": "array",
                "items": { "enum": ["apply", "bootstrap", "project", "observe", "duplicate", "reject_stale", "reject_gap"] }
              },
              "ordinary_snapshot_count": { "const": 0 },
              "logical_projection": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
