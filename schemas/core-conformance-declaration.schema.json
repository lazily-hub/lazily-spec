{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazily.dev/schemas/core-conformance-declaration.schema.json",
  "title": "Lazily Core conformance declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "binding_id",
    "report_command",
    "runtime_skips",
    "fixtureless_claims"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "binding_id": { "type": "string", "minLength": 1 },
    "report_command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Shell-free argv executed from the binding root to create LAZILY_CORE_REPORT_PATH."
    },
    "runtime_skips": {
      "type": "array",
      "items": { "$ref": "#/$defs/runtime_skip" }
    },
    "fixtureless_claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixtureless_claim" }
    }
  },
  "$defs": {
    "runtime_skip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "scenario", "reason"],
      "properties": {
        "fixture": { "type": "string", "minLength": 1 },
        "scenario": {
          "type": "string",
          "minLength": 1,
          "description": "A profile scenario id, or * for every scenario in the selected execution flavor(s)."
        },
        "execution_flavor": {
          "type": "string",
          "minLength": 1,
          "description": "Optional canonical profile execution flavor. Omit to skip the scenario in every flavor."
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "fixtureless_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "proof_classes", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "proof_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Shell-free argv executed from the binding root. It must recreate LAZILY_CORE_EVIDENCE_PATH and exit successfully."
        }
      }
    }
  }
}
