{
  "protocol_version": 1,
  "kind": "DurableOwner",
  "model": "ProjectionFingerprint",
  "description": "Projection content and ordered history are separate proof dimensions: equal final state does not certify complete history, and latest-value conflation advertises only latest-state capability.",
  "scenarios": [
    {
      "id": "equal_projection_does_not_fold_distinct_complete_histories",
      "owner_id": "counter-1",
      "mode": "event_history",
      "fence": 5,
      "fingerprint_case": {
        "left_history": [
          { "position": 1, "payload": { "schema_version": 7, "codec_version": 11, "bytes": "+1" } },
          { "position": 2, "payload": { "schema_version": 7, "codec_version": 11, "bytes": "-1" } }
        ],
        "right_history": [
          { "position": 1, "payload": { "schema_version": 7, "codec_version": 11, "bytes": "+0" } },
          { "position": 2, "payload": { "schema_version": 7, "codec_version": 11, "bytes": "+0" } }
        ],
        "left_projection": { "schema_version": 7, "codec_version": 11, "bytes": "0" },
        "right_projection": { "schema_version": 7, "codec_version": 11, "bytes": "0" },
        "left_latest": { "schema_version": 7, "codec_version": 11, "bytes": "0" },
        "right_latest": { "schema_version": 7, "codec_version": 11, "bytes": "0" },
        "expect": {
          "projection_fingerprint_relation": "equal",
          "history_fingerprint_relation": "different",
          "latest_fingerprint_relation": "equal",
          "history_capability": "complete_history",
          "latest_capability": "latest_state_only"
        }
      },
      "reconciliation_cases": [
        {
          "id": "ordered_create_amend_replay_is_equivalent",
          "history": [
            { "position": 1, "type": "create", "entity_id": "a", "value": "one" },
            { "position": 2, "type": "create", "entity_id": "b", "value": "two" },
            { "position": 3, "type": "amend", "entity_id": "a", "value": "three" }
          ],
          "resume_from": null,
          "expected": {
            "through": 3,
            "projection_version": 3,
            "entries": [
              { "entity_id": "a", "value": "three" },
              { "entity_id": "b", "value": "two" }
            ]
          },
          "observed_projection": {
            "through": 3,
            "projection_version": 3,
            "entries": [
              { "entity_id": "a", "value": "three" },
              { "entity_id": "b", "value": "two" }
            ]
          },
          "expect": {
            "health": "healthy",
            "drift": false,
            "lag": 0,
            "transition_authority": "durable_owner",
            "reconciliation_effect_id": "reconcile/counter-1/3"
          }
        },
        {
          "id": "partial_retraction_preserves_unrelated_entities",
          "history": [
            { "position": 1, "type": "create", "entity_id": "a", "value": "one" },
            { "position": 2, "type": "create", "entity_id": "b", "value": "two" },
            { "position": 3, "type": "retract", "entity_id": "a" }
          ],
          "resume_from": null,
          "expected": {
            "through": 3,
            "projection_version": 3,
            "entries": [{ "entity_id": "b", "value": "two" }]
          },
          "observed_projection": {
            "through": 2,
            "projection_version": 2,
            "entries": [
              { "entity_id": "a", "value": "one" },
              { "entity_id": "b", "value": "two" }
            ]
          },
          "expect": {
            "health": "lagging",
            "drift": true,
            "lag": 1,
            "transition_authority": "durable_owner",
            "reconciliation_effect_id": "reconcile/counter-1/3"
          }
        },
        {
          "id": "final_retraction_projects_empty_state",
          "history": [
            { "position": 1, "type": "create", "entity_id": "a", "value": "one" },
            { "position": 2, "type": "retract", "entity_id": "a" }
          ],
          "resume_from": null,
          "expected": { "through": 2, "projection_version": 2, "entries": [] },
          "observed_projection": {
            "through": 2,
            "projection_version": 2,
            "entries": [{ "entity_id": "a", "value": "stale-cache" }]
          },
          "expect": {
            "health": "drifted",
            "drift": true,
            "lag": 0,
            "transition_authority": "durable_owner",
            "reconciliation_effect_id": "reconcile/counter-1/2"
          }
        },
        {
          "id": "checkpoint_restart_resumes_without_cache_authority",
          "history": [
            { "position": 3, "type": "amend", "entity_id": "a", "value": "three" },
            { "position": 4, "type": "create", "entity_id": "b", "value": "four" }
          ],
          "resume_from": {
            "through": 2,
            "projection_version": 2,
            "entries": [{ "entity_id": "a", "value": "two" }]
          },
          "expected": {
            "through": 4,
            "projection_version": 4,
            "entries": [
              { "entity_id": "a", "value": "three" },
              { "entity_id": "b", "value": "four" }
            ]
          },
          "observed_projection": {
            "through": 1,
            "projection_version": 1,
            "entries": [{ "entity_id": "a", "value": "cache-only" }]
          },
          "expect": {
            "health": "lagging",
            "drift": true,
            "lag": 3,
            "transition_authority": "durable_owner",
            "reconciliation_effect_id": "reconcile/counter-1/4"
          }
        }
      ]
    },
    {
      "id": "schema_and_codec_versions_domain_separate_fingerprints",
      "owner_id": "counter-versions",
      "mode": "event_history",
      "fence": 5,
      "fingerprint_case": {
        "left_history": [
          { "position": 1, "payload": { "schema_version": 7, "codec_version": 11, "bytes": "0" } }
        ],
        "right_history": [
          { "position": 1, "payload": { "schema_version": 11, "codec_version": 7, "bytes": "0" } }
        ],
        "left_projection": { "schema_version": 7, "codec_version": 11, "bytes": "0" },
        "right_projection": { "schema_version": 11, "codec_version": 7, "bytes": "0" },
        "left_latest": { "schema_version": 7, "codec_version": 11, "bytes": "0" },
        "right_latest": { "schema_version": 11, "codec_version": 7, "bytes": "0" },
        "expect": {
          "projection_fingerprint_relation": "different",
          "history_fingerprint_relation": "different",
          "latest_fingerprint_relation": "different",
          "history_capability": "complete_history",
          "latest_capability": "latest_state_only"
        }
      }
    }
  ]
}
