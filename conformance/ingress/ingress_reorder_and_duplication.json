              "stamped_at": 0
            },
            "retry": null
          }
        },
        "receipts": {
          "accepted": 0,
          "dropped": 1,
          "error": 0
        },
        "invalidates": {
          "scopes": {
            "alpha": {
              "value": false,
              "readiness": false,
              "authority": false,
              "retry": false
            }
          },
          "receipts": {
            "accepted": false,
            "dropped": false,
            "error": false
          }
        }
      }
    },
    {
      "op": {
        "type": "admit",
        "key": "alpha",
        "generation": 1,
        "sequence": 0,
        "stamped_at": 0,
        "payload": 1
      },
      "returns": {
        "admission": "conflated",
        "delivered_through": 2
      },
      "expected": {
        "scopes": {
          "alpha": {
            "lifecycle": "live",
            "generation": 1,
            "delivered_through": 2,
            "buffered": 0,
            "window": 7,
            "readiness": "ready",
            "consecutive_errors": 0,
