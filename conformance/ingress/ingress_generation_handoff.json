        "admission": "accepted",
        "delivered_through": 0
      },
      "expected": {
        "scopes": {
          "alpha": {
            "lifecycle": "live",
            "generation": 2,
            "delivered_through": 0,
            "buffered": 0,
            "window": 5,
            "readiness": "ready",
            "consecutive_errors": 0,
            "authority": {
              "generation": 2,
              "delivered_through": 0,
              "stamped_at": 0
            },
            "retry": null
          }
        },
        "receipts": {
          "accepted": 1,
          "dropped": 0,
          "error": 0
        },
        "invalidates": {
          "scopes": {
            "alpha": {
              "value": true,
