{
  "description": "Build-skew generation handoff. A zombie producer is fenced BEFORE its stale sequence is consulted, and a newer incarnation resets the baseline: the old buffered successors and the old undrained window are both discarded. A handoff that arrives OUT OF ORDER still resets the baseline before parking the envelope: reporting that as an invisible buffer would strand every reader on the superseded generation.",
  "kind": "Ingress",
  "model": "IngressCell",
  "merge": "sum",
  "transport": "event_channel",
  "poll_interval": 25,
  "policy": {
    "reorder_window": 4,
    "freshness_horizon": 100,
    "high_water": 64,
    "overflow": "conflate",
    "receipt_capacity": 32,
    "retry_base": 10,
    "retry_ceiling": 80
  },
  "steps": [
