  "model": "IngressCell",
  "merge": "sum",
  "transport": "event_channel",
  "poll_interval": 25,
  "policy": {
    "reorder_window": 4,
    "freshness_horizon": 30,
    "high_water": 64,
    "overflow": "conflate",
    "receipt_capacity": 32,
    "retry_base": 10,
    "retry_ceiling": 80
  },
