{
  "description": "ReplayHarness — a divergence is reported at the FIRST checkpoint where the values parted, naming the diverging cell label, not merely at the final state where the defect is still visible. `drifting_accumulator(drift_at=1, drift=100)` takes a value from outside its log at seq 1; the fingerprint recorded with drift=0 therefore diverges at seq 1 on label `sum`, while seq 0 still matches. The second half pins the stride binding: a fingerprint recorded at stride 2 checkpoints [-1,1,3] and must be refused by a stride-1 harness, because equal log digest plus equal stride is what makes two checkpoint sequences comparable.",
  "kind": "Replay",
  "model": "ReplayHarness",
  "config": {
    "subject": "drifting_accumulator",
    "drift_at": 1,
    "logs": {
      "a": [
        { "seq": 0, "name": "add", "payload": 1 },
        { "seq": 1, "name": "add", "payload": 2 },
        { "seq": 2, "name": "add", "payload": 3 },
        { "seq": 3, "name": "add", "payload": 4 }
      ]
    }
  },
  "steps": [
    {
      "op": { "type": "record", "log": "a", "drift": 0, "stride": 1, "into": "fp_clean" },
      "expected": {
        "outcome": "recorded",
        "checkpoint_seqs": [-1, 0, 1, 2, 3],
        "final_sum": 10,
        "stride": 1
      }
    },
    {
      "op": { "type": "verify", "log": "a", "drift": 0, "stride": 1, "fingerprint": "fp_clean" },
      "expected": { "outcome": "ok", "divergences": 0 }
    },
    {
      "op": { "type": "verify", "log": "a", "drift": 100, "stride": 1, "fingerprint": "fp_clean" },
      "expected": {
        "outcome": "divergent",
        "first_divergent_seq": 1,
        "first_divergent_label": "sum",
        "first_divergent_kind": "value",
        "property": "divergence_is_reported_at_its_first_checkpoint"
      }
    },
    {
      "op": { "type": "prove", "log": "a", "drift": 0, "stride": 1, "replays": 2 },
      "expected": { "outcome": "ok", "divergences": 0 }
    },
    {
      "op": { "type": "record", "log": "a", "drift": 0, "stride": 2, "into": "fp_sparse" },
      "expected": {
        "outcome": "recorded",
        "checkpoint_seqs": [-1, 1, 3],
        "final_sum": 10,
        "stride": 2
      }
    },
    {
      "op": { "type": "verify", "log": "a", "drift": 0, "stride": 1, "fingerprint": "fp_sparse" },
      "expected": {
        "outcome": "stride_mismatch",
        "divergences": 0,
        "property": "a_fingerprint_is_bound_to_the_stride_it_was_sampled_at"
      }
    },
    {
      "op": { "type": "verify", "log": "a", "drift": 0, "stride": 2, "fingerprint": "fp_sparse" },
      "expected": { "outcome": "ok", "divergences": 0 }
    }
  ]
}
