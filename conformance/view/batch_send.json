    {"id": "items", "role": "list", "children": ["a", "b"], "flow": null},
    {"id": "a", "role": "text", "children": [], "flow": null},
    {"id": "b", "role": "text", "children": [], "flow": null},
    {"id": "go", "role": "button", "children": [], "flow": null}
  ],
  "trace": [],
